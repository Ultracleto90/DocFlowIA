NODE_ENV=development
APP_URL=http://localhost

# Nota: Las contraseñas con '!' deben codificarse como '%21' en URIs MongoDB
# Conexión operativa principal (Principio de Mínimo Privilegio: readWrite)
MONGO_URI=mongodb://worker_ia_service:<WORKER_PASSWORD_URL_ENCODED>@host.docker.internal:27017/DocuFlowAI?authSource=DocuFlowAI

# Conexión exclusiva de solo lectura para módulo QA / Auditoría (read)
MONGO_URI_READONLY=mongodb://auditor_qa_docuflow:<AUDITOR_PASSWORD_URL_ENCODED>@host.docker.internal:27017/DocuFlowAI?authSource=DocuFlowAI

# Seguridad de sesión (cambiar en entorno real)
JWT_SECRET=docuflow_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=7d

# Ruta física dentro del contenedor para los .zip
UPLOADS_DIR=/storage/uploads

# Futuro microservicio Python (Fase 2 - opcional en esta iteración)
AI_PIPELINE_MODE=local_analyzer
AI_SERVICE_URL=http://ai-worker:8000
